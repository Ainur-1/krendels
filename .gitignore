# Окружение uv строит из pyproject.toml и uv.lock; само дерево привязано к машине и
# весит несколько сотен мегабайт.
.venv/

# Результаты сборки и кеши. Ничто из этого ни для чего не является входными данными.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Собранный интерфейс. Пересобирается командой `npm run build` и при сборке образа,
# поэтому в репозитории лежала бы только устаревшая копия, расходящаяся с frontend/src.
src/cosmo_net/serving/static/
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Прогоны воспроизводятся из породившего их сценария: хранилище — это кеш, а не
# запись. Числа, на которые ссылаются README и защита, лежат в reports/metrics/.
runs.sqlite3

# Адрес сервера и путь к ключу. Их читает деплой, и публиковать их мы не вправе.
ansible/inventory.ini
.env

# Личные рабочие файлы. CLAUDE.md описывает, как один человек работает с ассистентом,
# и ничего не утверждает о проекте; измеренные выводы, которые он нёс, лежат в
# docs/findings.md — он в репозитории, потому что нужен команде и защите.
CLAUDE.md
.claude/
.vscode/
.idea/

# Выгрузки результата. Каждая воспроизводится из сервиса за секунду кнопкой
# «Выгрузить результат», поэтому в репозитории лежала бы копия, устаревающая при
# первом же изменении расчёта.
exports/

# Рабочие заметки, а не результат работы. Сценарий защиты и всё прочее, написанное,
# чтобы объяснить работу самим себе, в репозиторий не попадает.
docs/presentation.md
docs/notes/

.DS_Store
