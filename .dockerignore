# Контекст сборки уходит демону до того, как что-либо начнёт выполняться, поэтому всё,
# чем образ не может воспользоваться, здесь — мёртвый груз.

.git/
.github/

# Окружения и кеши. Образ строит своё из pyproject.toml и uv.lock.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Собирается стадией интерфейса внутри образа; устаревшая локальная копия победить не должна.
src/cosmo_net/serving/static/

# Тесты, отчёты и материалы кейса: из запроса ничто из этого недостижимо. Эталонный
# модуль тоже остаётся снаружи — он существует, чтобы проверять пакет, а не работать.
tests/
reference/
reports/
docs/
scripts/

# Локальное состояние и личные файлы.
runs.sqlite3
.env
CLAUDE.md
.claude/
.DS_Store
