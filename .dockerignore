# The build context is sent to the daemon before anything runs, so everything the
# image cannot use is dead weight here.

.git/
.github/

# Environments and caches. The image builds its own from pyproject.toml and uv.lock.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Built by the frontend stage inside the image; a stale local copy must not win.
src/cosmo_net/serving/static/

# Tests, reports and case material: none of it is reachable from a request. The
# reference module stays out too - it exists to check the package, not to run it.
tests/
reference/
reports/
docs/
scripts/

# Local state and personal files.
runs.sqlite3
.env
CLAUDE.md
.claude/
.DS_Store
